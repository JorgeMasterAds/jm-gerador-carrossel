# ── Licença da ferramenta ──────────────────────────────────────────────────────
# Senha de ativação — sem isso, os scripts se recusam a rodar
LICENSE_KEY=JMADS

# ── Supabase (armazenamento das artes) ─────────────────────────────────────────
# Crie seu projeto grátis em supabase.com → Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...   # service_role key (NÃO a anon key)
SUPABASE_BUCKET=criativos      # nome do bucket de storage (crie um bucket público com este nome)

# ── Trello ────────────────────────────────────────────────────────────────────
# Sua própria chave e token — NUNCA use os de outra pessoa/conta.
# Tutorial completo: docs/TUTORIAL-INSTALACAO.md → seção "Trello"
TRELLO_KEY=sua_api_key_aqui
TRELLO_TOKEN=seu_token_aqui

# ID do seu quadro (board) — vem da URL do quadro no Trello
TRELLO_BOARD_ID=id_do_seu_quadro

# Prefixo dos códigos dos seus cards (ex: "jm-" gera jm-c01, jm-c02...)
CARD_PREFIX=jm-

# IDs das listas do SEU quadro (copiar de: lista → menu "···" → "Link para lista")
# Crie as listas na MESMA ordem descrita em docs/TUTORIAL-INSTALACAO.md
TRELLO_LIST_ID=id_da_lista_padrao
TRELLO_LIST_FILA=id_da_lista_fila_gerado
TRELLO_LIST_APROVAR_COPY=id_da_lista_copy_aprovada
TRELLO_LIST_APROVAR_ARTE=id_da_lista_aprovar_arte
TRELLO_LIST_ARTE_APROVADA=id_da_lista_arte_aprovada
TRELLO_LIST_PUBLICADOS=id_da_lista_publicados

# ── Instagram / Meta ─────────────────────────────────────────────────────────
# ID numérico da conta do Instagram (não o @username)
# Obter em: Meta Business Suite → Configurações → Contas do Instagram
IG_ACCOUNT_ID=17841000000000000

# Token de acesso do sistema (nunca expira se gerado como System User Token)
# Obter em: Meta for Developers → app → Tools → Graph API Explorer
# Permissões necessárias: instagram_basic, instagram_content_publish, pages_read_engagement
IG_ACCESS_TOKEN=EAAMseu_token_aqui

# ── Chrome (puppeteer) ────────────────────────────────────────────────────────
# Caminho para o executável do Chrome instalado
# Windows:
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# macOS:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:
# CHROME_PATH=/usr/bin/google-chrome
